{
  "version": "2.0.0",
  "license": "MIT",
  "name": "jbrowse-plugin-ideogram",
  "description": "JBrowse 2 ideogram plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/jbrowse-plugin-ideogram.git"
  },
  "keywords": [
    "jbrowse",
    "jbrowse2"
  ],
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "setup": "node scripts/setup.js && pnpm browse-install",
    "clean": "rimraf dist",
    "format": "pnpm prettier --write .",
    "prebuild": "pnpm clean",
    "start": "node esbuild.mjs --watch",
    "build": "tsc && NODE_ENV=production node esbuild.mjs",
    "build:bundle": "NODE_ENV=production node esbuild.mjs",
    "postbuild": "cp distconfig.json dist/config.json",
    "browse-install": "cd .jbrowse && rm -rf * && jbrowse create .",
    "browse": "cd .jbrowse && cp ../jbrowse_config.json . && mv jbrowse_config.json config.json && npx serve .",
    "lint": "eslint --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "prepack": "pnpm build",
    "preversion": "pnpm lint",
    "version": "node -e \"console.log('export const version = \\'' + require('./package.json').version + '\\'')\" > src/version.ts && git add src/version.ts",
    "postversion": "git push --follow-tags"
  },
  "jbrowse-plugin": {
    "name": "Ideogram"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "dependencies": {
    "ideogram": "^1.29.0",
    "react-spinners": "^0.17.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@emotion/react": "^11.14.0",
    "@eslint/js": "^10.0.1",
    "@fal-works/esbuild-plugin-global-externals": "^2.1.2",
    "@jbrowse/cli": "^4.2.1",
    "@jbrowse/core": "^4.2.0",
    "@jbrowse/mobx-state-tree": "^5.6.0",
    "@jbrowse/plugin-linear-genome-view": "^4.2.0",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.10",
    "@mui/system": "^7.3.10",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "mobx": "^6.15.0",
    "mobx-react": "^9.2.1",
    "prettier": "^3.8.3",
    "pretty-bytes": "^7.1.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "serve": "^14.2.6",
    "tss-react": "^4.9.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  }
}
