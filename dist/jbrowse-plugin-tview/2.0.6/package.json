{
  "version": "2.0.6",
  "license": "MIT",
  "name": "jbrowse-plugin-tview",
  "repository": {
    "type": "git",
    "url": "https://github.com/cmdcolin/jbrowse-plugin-tview.git"
  },
  "keywords": [
    "jbrowse",
    "jbrowse2"
  ],
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "dev": "pnpm start",
    "start": "node esbuild.mjs --watch",
    "format": "pnpm prettier --write .",
    "prebuild": "pnpm clean",
    "build": "tsc && NODE_ENV=production node esbuild.mjs && cp distconfig.json dist/config.json",
    "lint": "eslint --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "test -d .test-jbrowse || pnpm dlx @jbrowse/cli create .test-jbrowse --nightly",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "prefigure": "pnpm pretest:e2e",
    "figure": "node scripts/figure.mjs",
    "prepack": "pnpm build",
    "preversion": "pnpm lint && pnpm build",
    "version": "node scripts/version.mjs",
    "postversion": "git push --follow-tags"
  },
  "jbrowse-plugin": {
    "name": "TView"
  },
  "dependencies": {
    "@emotion/styled": "^11.14.1",
    "swr": "^2.4.2"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@eslint/js": "^10.0.1",
    "@fal-works/esbuild-plugin-global-externals": "^2.1.2",
    "@gmod/bam": "^7.3.4",
    "@jbrowse/core": "^4.3.0",
    "@jbrowse/mobx-state-tree": "^5.13.0",
    "@jbrowse/plugin-linear-genome-view": "^4.3.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/system": "^9.2.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "mobx": "^6.16.1",
    "mobx-react": "^9.2.2",
    "prettier": "^3.9.6",
    "pretty-bytes": "^7.1.1",
    "puppeteer": "^25.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-msaview": "^5.6.3",
    "rimraf": "^6.1.3",
    "tss-react": "^4.9.21",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
