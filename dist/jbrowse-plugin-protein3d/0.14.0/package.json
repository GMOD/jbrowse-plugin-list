{
  "version": "0.14.0",
  "name": "jbrowse-plugin-protein3d",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/jbrowse-plugin-protein3d.git"
  },
  "keywords": [
    "jbrowse",
    "jbrowse2"
  ],
  "main": "dist/index.js",
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@jbrowse/app-core": "5.0.0-beta.8",
    "@jbrowse/plugin-linear-genome-view": "5.0.0-beta.8",
    "@mui/icons-material": "^9.4.0",
    "clustal-js": "^2.0.18",
    "g2p_mapper": "^2.1.7",
    "molstar": "^5.11.0",
    "p2s_mapper": "^1.2.0",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^10.0.1",
    "@fal-works/esbuild-plugin-global-externals": "^2.1.2",
    "@jbrowse/core": "5.0.0-beta.8",
    "@jbrowse/mobx-state-tree": "^6.5.1",
    "@mui/material": "^9.4.0",
    "@mui/system": "^9.4.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^75.0.0",
    "fp-ts": "^2.16.11",
    "git-cliff": "^2.13.1",
    "jsdom": "^30.1.0",
    "mobx": "^7.0.3",
    "mobx-react": "^10.0.2",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.7",
    "pretty-bytes": "^7.1.3",
    "puppeteer": "^25.11.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.3",
    "rxjs": "^7.8.2",
    "serve": "^14.2.6",
    "tss-react": "^4.9.21",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "8.3.0",
    "vitest": "^5.0.1"
  },
  "author": "Colin <colin.diesh@gmail.com>",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "node scripts/test-versions.mjs setup && node scripts/test-versions.mjs run",
    "test:setup": "node scripts/test-versions.mjs setup",
    "test:setup:version": "node scripts/test-versions.mjs setup",
    "test:versions": "node scripts/test-versions.mjs run",
    "test:version": "node scripts/test-versions.mjs run",
    "test:docs": "node scripts/test-docs.mjs",
    "readme-figure": "node scripts/readme-figure.mjs",
    "host-compat": "node scripts/host-compat-probe.mjs",
    "host-compat:candidate": "node scripts/host-compat-probe.mjs --bundle dist/jbrowse-plugin-protein3d.umd.production.min.js --versions v4.0.0,v4.3.0,latest,main --floor v4.0.0 --json host-compat.json",
    "check-host-externals": "node scripts/check-host-externals.mjs",
    "update-host-reexports": "node scripts/update-host-reexports.mjs",
    "check-demos": "node scripts/check-demos.mjs --bundle dist/jbrowse-plugin-protein3d.umd.production.min.js",
    "clean": "rimraf dist",
    "build:harness": "vite build --config harness/vite.config.mts --base=/jbrowse-plugin-protein3d/",
    "fetch-molstar-css": "node scripts/fetch-molstar-css.mjs",
    "format": "pnpm prettier --write .",
    "format:check": "pnpm prettier --check .",
    "prebuild": "pnpm clean",
    "start": "pnpm fetch-molstar-css && node esbuild.mjs --watch",
    "build": "tsc && NODE_ENV=production node esbuild.mjs && cp distconfig.json dist/config.json",
    "build:bundle": "NODE_ENV=production node esbuild.mjs",
    "lint": "eslint src test --report-unused-disable-directives --max-warnings 0",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "pretest": "node scripts/ensure-nightly.mjs",
    "check-ci": "node scripts/require-green-ci.mjs",
    "preversion": "pnpm check-ci && pnpm format:check && pnpm lint && pnpm build && pnpm check-host-externals && pnpm host-compat:candidate",
    "version": "node scripts/sync-version.mjs && git-cliff --tag v$npm_package_version --unreleased --prepend CHANGELOG.md && git add src/version.ts CHANGELOG.md",
    "postversion": "git push --follow-tags"
  }
}