{
  "version": "0.8.4",
  "name": "jbrowse-plugin-protein3d",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/jbrowse-plugin-protein3d.git"
  },
  "keywords": [
    "jbrowse",
    "jbrowse2"
  ],
  "main": "dist/index.js",
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@jbrowse/app-core": "^4.3.0",
    "@jbrowse/plugin-linear-genome-view": "^4.3.0",
    "@mui/icons-material": "^7.3.11",
    "clustal-js": "^2.0.17",
    "g2p_mapper": "^2.1.6",
    "molstar": "^5.11.0",
    "swr": "^2.5.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@eslint/js": "^10.0.1",
    "@fal-works/esbuild-plugin-global-externals": "^2.1.2",
    "@jbrowse/core": "^4.3.0",
    "@jbrowse/mobx-state-tree": "^5.13.0",
    "@mui/material": "^7.3.11",
    "@mui/system": "^7.3.11",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^64.0.0",
    "fp-ts": "^2.16.11",
    "git-cliff": "^2.13.1",
    "jsdom": "^29.1.1",
    "mobx": "^6.16.1",
    "mobx-react": "^9.2.2",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "pretty-bytes": "^7.1.1",
    "puppeteer": "^25.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.4",
    "rxjs": "^7.8.2",
    "serve": "^14.2.6",
    "tss-react": "^4.9.21",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "8.0.5",
    "vitest": "^4.1.10"
  },
  "author": "Colin <colin.diesh@gmail.com>",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "node scripts/test-versions.mjs setup && node scripts/test-versions.mjs run",
    "test:setup": "node scripts/test-versions.mjs setup",
    "test:setup:version": "node scripts/test-versions.mjs setup",
    "test:versions": "node scripts/test-versions.mjs run",
    "test:version": "node scripts/test-versions.mjs run",
    "test:docs": "node scripts/test-docs.mjs",
    "host-compat": "node scripts/host-compat-probe.mjs",
    "host-compat:candidate": "node scripts/host-compat-probe.mjs --bundle dist/jbrowse-plugin-protein3d.umd.production.min.js --versions v4.0.0,v4.3.0,latest,main --floor v4.0.0 --json host-compat.json",
    "clean": "rimraf dist",
    "build:harness": "vite build --config harness/vite.config.mts --base=/jbrowse-plugin-protein3d/",
    "fetch-molstar-css": "node scripts/fetch-molstar-css.mjs",
    "format": "pnpm prettier --write .",
    "format:check": "pnpm prettier --check .",
    "prebuild": "pnpm clean",
    "start": "pnpm fetch-molstar-css && node esbuild.mjs --watch",
    "build": "tsc && NODE_ENV=production node esbuild.mjs && cp distconfig.json dist/config.json",
    "build:bundle": "NODE_ENV=production node esbuild.mjs",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "pretest": "node scripts/ensure-nightly.mjs",
    "preversion": "pnpm format:check && pnpm lint && pnpm build && pnpm host-compat:candidate",
    "version": "node scripts/sync-version.mjs && git-cliff --tag v$npm_package_version --unreleased --prepend CHANGELOG.md && git add src/version.ts CHANGELOG.md",
    "postversion": "git push --follow-tags"
  }
}