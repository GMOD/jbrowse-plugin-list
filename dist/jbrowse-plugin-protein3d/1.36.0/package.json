{
  "version": "1.36.0",
  "name": "jbrowse-plugin-protein3d",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/jbrowse-plugin-protein3d.git"
  },
  "keywords": [
    "jbrowse",
    "jbrowse2"
  ],
  "type": "module",
  "main": "dist/jbrowse-plugin-protein3d.esm.js",
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@gmod/tabix": "^3.13.1",
    "@mui/icons-material": "^9.6.0",
    "clustal-js": "^2.0.19",
    "g2p_mapper": "^2.3.1",
    "molstar": "^5.13.1",
    "p2s_mapper": "^3.3.0",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@jbrowse/core": "5.0.0-beta.19",
    "@jbrowse/display-kit": "5.0.0-beta.19",
    "@jbrowse/mobx-state-tree": "^6.10.1",
    "@jbrowse/plugin-linear-genome-view": "5.0.0-beta.19",
    "@mui/material": "^9.6.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "git-cliff": "^2.14.2",
    "jsdom": "^31.0.1",
    "mobx": "^7.1.7",
    "mobx-react": "^10.0.4",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "pretty-bytes": "^7.2.0",
    "puppeteer": "^25.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.4",
    "rxjs": "^7.8.2",
    "serve": "^14.2.8",
    "tsrs": "7.1.0-beta.tsrs4",
    "tss-react": "^4.9.21",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "8.3.8",
    "vitest": "^5.1.1"
  },
  "author": "Colin <colin.diesh@gmail.com>",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "test:docs": "node scripts/test-docs.mjs",
    "readme-figure": "node scripts/readme-figure.mjs",
    "host-compat": "node scripts/host-compat-probe.mjs",
    "host-compat:candidate": "node scripts/host-compat-probe.mjs --bundle dist/jbrowse-plugin-protein3d.esm.js --json host-compat.json",
    "check-demos": "node scripts/check-demos.mjs --bundle dist/jbrowse-plugin-protein3d.esm.js",
    "check-host-floor": "node scripts/check-host-floor.mjs",
    "clean": "rimraf dist",
    "build:harness": "vite build --config harness/vite.config.mts --base=/jbrowse-plugin-protein3d/",
    "fetch-molstar-css": "node scripts/fetch-molstar-css.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prebuild": "pnpm clean",
    "start": "pnpm fetch-molstar-css && node esbuild.mjs --watch",
    "build": "tsc --noEmit && NODE_ENV=production node esbuild.mjs && cp harness/public/config.json dist/config.json",
    "build:bundle": "NODE_ENV=production node esbuild.mjs",
    "check-molstar-css": "node scripts/fetch-molstar-css.mjs --check",
    "lint": "OXLINT_TSGOLINT_PATH=node_modules/.bin/tsgolint oxlint --type-aware --tsconfig tsconfig.test.json --deny-warnings && pnpm check-molstar-css",
    "pretest": "node scripts/ensure-nightly.mjs",
    "check-ci": "node scripts/require-green-ci.mjs",
    "preversion": "pnpm check-ci && pnpm format:check && pnpm lint && pnpm build && pnpm check-host-floor && pnpm host-compat:candidate",
    "version": "node scripts/sync-version.mjs && git-cliff --tag v$npm_package_version --unreleased --prepend CHANGELOG.md && git add src/version.ts CHANGELOG.md",
    "postversion": "git push --follow-tags",
    "lint:eslint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsrs --noEmit -p tsconfig.test.json && tsrs --noEmit -p harness/tsconfig.json"
  }
}