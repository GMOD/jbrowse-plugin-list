{
  "name": "jbrowse-plugin-tandem-repeat",
  "version": "0.1.4",
  "description": "JBrowse 2 view of a tandem repeat's alleles: one bar per haplotype, each copy coloured by its repeat unit, read from VCF 4.5 <CNV:TR> records",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/jbrowse-plugin-tandem-repeat.git"
  },
  "keywords": [
    "jbrowse",
    "jbrowse2",
    "tandem repeat",
    "VNTR"
  ],
  "type": "module",
  "main": "dist/jbrowse-plugin-tandem-repeat.esm.js",
  "module": "dist/jbrowse-plugin-tandem-repeat.esm.js",
  "exports": "./dist/jbrowse-plugin-tandem-repeat.esm.js",
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@jbrowse/core": "5.0.0-beta.9"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^10.0.1",
    "@fal-works/esbuild-plugin-global-externals": "^2.1.2",
    "@jbrowse/mobx-state-tree": "^6.6.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "git-cliff": "^2.14.2",
    "jsdom": "^30.1.1",
    "mobx": "^7.0.4",
    "mobx-react": "^10.0.2",
    "prettier": "^3.9.9",
    "pretty-bytes": "^7.1.3",
    "puppeteer": "^25.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "typescript7": "npm:typescript@^7.0.2",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rimraf dist",
    "format": "pnpm prettier --write .",
    "format:check": "pnpm prettier --check .",
    "prebuild": "pnpm clean",
    "dev": "pnpm start",
    "start": "node esbuild.mjs --watch",
    "build": "NODE_ENV=production node esbuild.mjs",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit",
    "lint": "eslint --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "figures": "node scripts/shoot-figures.mjs",
    "preversion": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "version": "node scripts/version.mjs",
    "postversion": "git push --follow-tags"
  }
}