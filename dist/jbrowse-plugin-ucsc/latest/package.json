{
  "name": "jbrowse-plugin-ucsc",
  "version": "1.0.4",
  "description": "JBrowse 2 UCSC API plugin",
  "repository": "github:cmdcolin/jbrowse-plugin-ucsc-api",
  "jbrowse-plugin": {
    "name": "UCSC"
  },
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "scripts": {
    "clean": "rimraf dist",
    "format": "pnpm prettier --write .",
    "prebuild": "pnpm clean",
    "start": "node esbuild.mjs --watch",
    "build": "tsc -p tsconfig.build.json && NODE_ENV=production node esbuild.mjs",
    "build:bundle": "NODE_ENV=production node esbuild.mjs",
    "postbuild": "cp distconfig.json dist/config.json",
    "lint": "eslint --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "prepack": "pnpm build",
    "preversion": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "postversion": "git push --follow-tags",
    "typecheck": "tsc"
  },
  "files": [
    "dist",
    "src"
  ],
  "author": "Colin Diesh",
  "license": "MIT",
  "keywords": [
    "jbrowse",
    "jbrowse2"
  ],
  "prettier": {
    "semi": false,
    "trailingComma": "all",
    "singleQuote": true,
    "arrowParens": "avoid"
  },
  "peerDependencies": {
    "@jbrowse/core": ">=2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fal-works/esbuild-plugin-global-externals": "^2.1.2",
    "@jbrowse/core": "5.0.0-beta.20",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^64.0.0",
    "prettier": "^3.8.3",
    "pretty-bytes": "^7.1.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  }
}
