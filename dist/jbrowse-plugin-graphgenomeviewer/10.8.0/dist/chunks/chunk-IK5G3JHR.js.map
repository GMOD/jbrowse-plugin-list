const host = JBrowseExports["@jbrowse/core/util/samplesTsv"]
const read = name =>
  host != null && name in Object(host)
    ? host[name]
    : Object.assign(
        function () {
          throw new Error("This JBrowse does not provide '" + name + "' from '" + "@jbrowse/core/util/samplesTsv" + "' to plugins: " + "GraphGenomeView was built for a different JBrowse version, so update the plugin or JBrowse")
        },
        { jbrowseHostMissing: name },
      )
export const getSamplesTsvSources = /* @__PURE__ */ read("getSamplesTsvSources")
export const parseSamplesTsv = /* @__PURE__ */ read("parseSamplesTsv")
export const samplesTsvAdapterConfigSchemaFields = /* @__PURE__ */ read("samplesTsvAdapterConfigSchemaFields")
export default host && host.__esModule ? host.default : host