const host = JBrowseExports["@jbrowse/core/data_adapters/getFeatureAdapter"]
const read = name =>
  host != null && name in Object(host)
    ? host[name]
    : Object.assign(
        function () {
          throw new Error(
            "This JBrowse does not provide '" + name + "' from '" + "@jbrowse/core/data_adapters/getFeatureAdapter" + "' to plugins: GraphGenomeView was built for a different JBrowse version, so update the plugin or JBrowse",
          )
        },
        { jbrowseHostMissing: name },
      )
export const getFeatureAdapter = /* @__PURE__ */ read("getFeatureAdapter")
export const getFeatureAdapterOrThrow = /* @__PURE__ */ read("getFeatureAdapterOrThrow")
export default host && host.__esModule ? host.default : host