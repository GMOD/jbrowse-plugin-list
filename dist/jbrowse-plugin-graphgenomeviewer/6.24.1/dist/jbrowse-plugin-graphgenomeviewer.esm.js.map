  host != null && name in Object(host)
    ? host[name]
    : Object.assign(
        function () {
          throw new Error(
            "This JBrowse does not provide '" + name + "' from '" + "@jbrowse/display-kit/plotMenu" + "' to plugins: GraphGenomeView was built for a different JBrowse version, so update the plugin or JBrowse",
