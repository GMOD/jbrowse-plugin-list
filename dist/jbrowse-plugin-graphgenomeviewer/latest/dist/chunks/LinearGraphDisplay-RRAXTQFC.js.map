const host = JBrowseExports["@jbrowse/display-kit/DisplayChrome"]
const read = name =>
  host != null && name in Object(host)
    ? host[name]
    : Object.assign(
        function () {
          throw new Error("This JBrowse does not provide '" + name + "' from '" + "@jbrowse/display-kit/DisplayChrome" + "' to plugins: " + "GraphGenomeView was built for a different JBrowse version, so update the plugin or JBrowse")
        },
        { jbrowseHostMissing: name },
      )
export default host && host.__esModule ? host.default : host